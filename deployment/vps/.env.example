# ==============================================================================
# Production Environment Variables for VPS Deployment (deployment/vps/.env)
# ==============================================================================
# Copy this file to .env on your VPS inside /opt/oneself/deployment/vps/.env
#
#   cp .env.example .env
#   nano .env
# ==============================================================================

# --- Domain & SSL (Caddy) ---
DOMAIN_NAME=oneselfbd.com
DASHBOARD_DOMAIN=admin.oneselfbd.com
ACME_EMAIL=admin@oneselfbd.com

# --- Database Configuration ---
# OPTION 1: Using the built-in Docker MongoDB container (default)
MONGO_INITDB_ROOT_USERNAME=oneself
MONGO_INITDB_ROOT_PASSWORD=your_strong_mongo_password_here
MONGO_INITDB_DATABASE=oneself

# OPTION 2: If using external MongoDB (e.g., MongoDB Atlas, DocumentDB, or managed DB)
# Uncomment the line below. When DB_URL is set, it overrides the internal container URI.
# DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/oneself?retryWrites=true&w=majority

# --- Authentication Secrets (Server) ---
ACCESS_TOKEN_SECRET=generate_a_long_random_secret_for_access_token_32_chars_min
REFRESH_TOKEN_SECRET=generate_a_long_random_secret_for_refresh_token_32_chars_min

# --- File Storage ---
UPLOAD_PLATFORM=local
# If using Cloudflare R2:
# UPLOAD_PLATFORM=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://cdn.oneselfbd.com

# --- SMS & Email (Optional/As Needed) ---
# BL_USERNAME=
# BL_PASSWORD=
# SENDER_ID=
# EMAIL_USER=
# EMAIL_PASS=
