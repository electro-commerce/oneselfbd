# ==============================================================================
# Production Environment Variables for VPS Deployment (deployment/vps/.env)
# ==============================================================================
# Copy this file to .env on your VPS inside /opt/oneself/deployment/vps/.env
#
#   cp .env.example .env
#   nano .env
# ==============================================================================

# --- Domain & SSL (Caddy) ---
DOMAIN_NAME=oneselfbd.com
DASHBOARD_DOMAIN=oneselfbd.com
ACME_EMAIL=admin@oneselfbd.com

# --- Database Configuration ---
# Production Compose always connects the API to its managed MongoDB service.
# Both DB_URL and MONGODB_URI are set by Compose; old host URIs in .env are overridden.
# One MongoDB instance runs as single-member rs0 for transaction support.
# Data persists in mongodb_data; replica-set metadata persists with the database.
# No MongoDB host port or UFW rule is needed.

# --- Storefront Cache Revalidation ---
# Generate with: openssl rand -hex 32
# Passed to both Next.js servers at runtime. Also set the same value as
# NEXT_PUBLIC_REVALIDATE_SECRET inside GitHub DASHBOARD_ENV_PRODUCTION.
REVALIDATE_SECRET=replace_with_a_long_random_secret

# --- Authentication Secrets (Server) ---
ACCESS_TOKEN_SECRET=generate_a_long_random_secret_for_access_token_32_chars_min
REFRESH_TOKEN_SECRET=generate_a_long_random_secret_for_refresh_token_32_chars_min

# --- Google Tag Manager (GTM) Server-Side Tagging ---
# Official Google GTM Server Container support (Tagging Server + Preview Server).
#
# 1. Container Config:
#    In Google Tag Manager -> Server Container -> Container ID (top right)
#    -> "Manually provision tagging server" -> copy the Container Config string.
GTM_CONTAINER_CONFIG=replace_with_gtm_server_container_config_string

# 2. Tracking & Preview Domains / URLs:
#    Point DNS A/CNAME records for tracking and preview subdomains to your VPS IP.
GTM_TRACKING_DOMAIN=tracking.oneselfbd.com
GTM_PREVIEW_DOMAIN=preview.tracking.oneselfbd.com
GTM_PREVIEW_SERVER_URL=https://preview.tracking.oneselfbd.com

# 3. Host Port Bindings (Loopback):
#    GTM Tagging Server listens on port 8080; Preview Server listens on port 8081.
GTM_SERVER_PORT=8080
GTM_PREVIEW_PORT=8081

# --- File Storage ---
UPLOAD_PLATFORM=local
# If using Cloudflare R2:
# UPLOAD_PLATFORM=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://cdn.oneselfbd.com

# --- SMS & Email (Optional/As Needed) ---
# BL_USERNAME=
# BL_PASSWORD=
# SENDER_ID=
# EMAIL_USER=
# EMAIL_PASS=

# --- Prebuilt application images (manual deployment only) ---
# The automated workflow sets these and records them in .env.images after deployment.
# IMAGE_REPOSITORY=ghcr.io/owner/repository
# IMAGE_TAG=full_commit_sha
