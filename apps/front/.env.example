# ==============================================================================
# ENVIRONMENT & CORE APIS
# ==============================================================================
NEXT_PUBLIC_FRONT_NODE_ENV="development" # Runtime mode: development | production
NEXT_PUBLIC_FRONT_API_BASE_URL="http://localhost:5000" # Backend server API base URL

# ==============================================================================
# CACHE REVALIDATION
# ==============================================================================
REVALIDATE_SECRET="" # Strong server-only secret; must match the dashboard REVALIDATE_SECRET

# ==============================================================================
# ANALYTICS & EVENT TRACKING
# ==============================================================================
NEXT_PUBLIC_FRONT_TRACKING_API_URL="http://localhost:5001/api/v1/events" # Order/event tracking server endpoint
NEXT_PUBLIC_FRONT_GTM_ID="" # Published Oneself web GTM container ID

# ==============================================================================
# LANDING PAGES
# ==============================================================================
LANDING_SMART_PIR_MOTION_SENSOR_LED_BULB_PRODUCT_IDS='["product-id-1","product-id-2"]' # Ordered product IDs or slugs; first product is selected by default
